          <mxGeometry x="170" y="73" width="250" height="28" as="geometry" />
        </mxCell>
        <mxCell id="l6_desc" value="每次命令执行记录到 sandbox_audit.log (JSON Lines)&#10;记录: 时间戳 | 命令 | 是否允许 | 退出码 | 耗时 | PID | 输出大小" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="100" y="105" width="700" height="35" as="geometry" />
