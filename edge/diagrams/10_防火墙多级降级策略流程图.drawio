        <!-- Encoding fix note -->
        <mxCell id="enc_note" value="🔧 关键修复: 所有 subprocess.run() 显式指定 encoding=&quot;utf-8&quot;, errors=&quot;replace&quot;&#10;避免 Windows 中文系统 GBK 编码导致的 UnicodeDecodeError 崩溃" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff9800;fontSize=10;fontColor=#e65100;align=center;" vertex="1" parent="1">
