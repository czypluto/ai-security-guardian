          <mxGeometry x="150" y="263" width="70" height="28" as="geometry" />
        </mxCell>
        <mxCell id="l4_title" value="资源限制 (Resource Limits)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontStyle=1;fontColor=#f9a825;align=left;" vertex="1" parent="1">
          <mxGeometry x="230" y="263" width="280" height="28" as="geometry" />
        </mxCell>
        <mxCell id="l4_desc" value="超时: 30秒 | 内存上限: 64MB | 输出上限: 16KB&#10;subprocess.communicate(timeout=30) + stdout[:16384] 截断" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="160" y="295" width="620" height="35" as="geometry" />
