<mxfile host="app.diagrams.net" modified="2026-07-28T00:00:00.000Z" agent="draw.io" version="24.0.0">
  <diagram name="PC与ESP32通信时序图" id="sequence">
    <mxGraphModel dx="900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" value="AI网络安全管家 — PC ↔ ESP32 通信时序图" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=16;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="180" y="5" width="540" height="30" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="lifeline_pc" value="" style="endArrow=none;html=1;strokeColor=#1565c0;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="60" as="sourcePoint" /><mxPoint x="150" y="820" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lifeline_bridge" value="" style="endArrow=none;html=1;strokeColor=#4caf50;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="60" as="sourcePoint" /><mxPoint x="400" y="820" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lifeline_esp" value="" style="endArrow=none;html=1;strokeColor=#e91e63;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="60" as="sourcePoint" /><mxPoint x="700" y="820" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Headers -->
        <mxCell id="header_pc" value="GuardianController&#10;(PC Agent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565c0;fontColor=#fff;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="40" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="header_bridge" value="DeviceBridge&#10;(通信桥梁)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4caf50;fontColor=#fff;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="40" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="header_esp" value="ESP32 + OLED&#10;(硬件终端)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e91e63;fontColor=#fff;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="40" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- 1. Scan -->
        <mxCell id="s1" value="1. 启动扫描循环" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontStyle=1;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="145" y="105" width="100" height="18" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="connect()" style="endArrow=classic;html=1;strokeColor=#1565c0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="150" y="125" as="sourcePoint" /><mxPoint x="400" y="125" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 2. Serial -->
        <mxCell id="a2" value="Serial 自动检测 COM 口 / WiFi TCP 连接" style="endArrow=classic;html=1;strokeColor=#4caf50;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="160" as="sourcePoint" /><mxPoint x="700" y="160" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="a2r" value='{"status":"ready"}' style="endArrow=classic;html=1;strokeColor=#e91e63;fontSize=10;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="195" as="sourcePoint" /><mxPoint x="400" y="195" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 3. Ping -->
        <mxCell id="a3" value="ping (每2秒心跳)" style="endArrow=classic;html=1;strokeColor=#4caf50;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="235" as="sourcePoint" /><mxPoint x="700" y="235" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="a3r" value="pong" style="endArrow=classic;html=1;strokeColor=#e91e63;fontSize=10;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="265" as="sourcePoint" /><mxPoint x="400" y="265" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 4. Update -->
        <mxCell id="s4" value="2. 扫描完成" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontStyle=1;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="145" y="295" width="80" height="18" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="send_update(state)" style="endArrow=classic;html=1;strokeColor=#1565c0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="150" y="315" as="sourcePoint" /><mxPoint x="400" y="315" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="a5" value='{"cmd":"update", "sec_level":"safe", "threat_count":0, "active_connections":42, "cpu_usage":23.5, ...}' style="endArrow=classic;html=1;strokeColor=#4caf50;fontSize=9;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="350" as="sourcePoint" /><mxPoint x="700" y="350" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="a5r" value='{"status":"ok"}' style="endArrow=classic;html=1;strokeColor=#e91e63;fontSize=10;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="385" as="sourcePoint" /><mxPoint x="400" y="385" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 5. Screen -->
        <mxCell id="s5" value="3. 用户切换屏幕" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontStyle=1;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="145" y="415" width="100" height="18" as="geometry" />
        </mxCell>
        <mxCell id="a6" value='send_command({&quot;cmd&quot;:&quot;screen&quot;,&quot;screen&quot;:1})' style="endArrow=classic;html=1;strokeColor=#1565c0;fontSize=9;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="150" y="435" as="sourcePoint" /><mxPoint x="700" y="435" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="a6r" value='{"status":"ok"}' style="endArrow=classic;html=1;strokeColor=#e91e63;fontSize=10;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="465" as="sourcePoint" /><mxPoint x="400" y="465" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s5n" value="[ESP32: 切换至仪表盘]" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#e91e63;" vertex="1" parent="1">
          <mxGeometry x="710" y="475" width="140" height="15" as="geometry" />
        </mxCell>

        <!-- 6. Danger -->
        <mxCell id="s6" value="4. 检测到威胁" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontStyle=1;fontColor=#b71c1c;" vertex="1" parent="1">
          <mxGeometry x="145" y="505" width="80" height="18" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="send_alert(&quot;可疑连接: 192.168.1.100:4444&quot;)" style="endArrow=classic;html=1;strokeColor=#b71c1c;fontSize=9;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="150" y="525" as="sourcePoint" /><mxPoint x="700" y="525" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s6n" value="[ESP32: 双线边框 + 🔴LED + 蜂鸣器5声]" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#b71c1c;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="535" width="180" height="15" as="geometry" />
        </mxCell>
        <mxCell id="s6n2" value="[角色表情→ &gt;_&lt; ANGRY]" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#b71c1c;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="552" width="160" height="15" as="geometry" />
        </mxCell>

        <!-- 7. Say -->
        <mxCell id="a8" value='send_command({"cmd":"say","text":"主人! 防火墙怎么关了!"})' style="endArrow=classic;html=1;strokeColor=#1565c0;fontSize=9;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="150" y="580" as="sourcePoint" /><mxPoint x="700" y="580" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s7n" value="[ESP32: 表情屏显示台词 + 匹配颜文字]" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#e91e63;" vertex="1" parent="1">
          <mxGeometry x="710" y="590" width="180" height="15" as="geometry" />
        </mxCell>

        <!-- 8. Disconnect -->
        <mxCell id="s8" value="5. 设备断连" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontStyle=1;fontColor=#ff9800;" vertex="1" parent="1">
          <mxGeometry x="145" y="625" width="80" height="18" as="geometry" />
        </mxCell>
        <mxCell id="dl1" value="30秒无数据 → 超时" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#ff9800;" vertex="1" parent="1">
          <mxGeometry x="710" y="630" width="140" height="15" as="geometry" />
        </mxCell>
        <mxCell id="dl2" value="[ESP32: 显示 &quot;!!&quot; + &quot;DISCONNECTED&quot;]" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#ff9800;" vertex="1" parent="1">
          <mxGeometry x="710" y="648" width="180" height="15" as="geometry" />
        </mxCell>

        <mxCell id="a9" value="_handle_disconnect() → 防重入锁 → 关闭旧串口 → 停止旧线程" style="endArrow=classic;html=1;strokeColor=#ff9800;fontSize=9;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="685" as="sourcePoint" /><mxPoint x="400" y="740" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="a10" value="重连成功 → 恢复通信" style="endArrow=classic;html=1;strokeColor=#4caf50;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="775" as="sourcePoint" /><mxPoint x="700" y="775" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- Notes -->
        <mxCell id="notes" value="通信协议: JSON over Serial (115200bps) | 心跳: 2秒 | 超时: 30秒 | 最大重连: 10次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9e9e9e;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="830" width="500" height="25" as="geometry" />
        </mxCell>
      </root>
