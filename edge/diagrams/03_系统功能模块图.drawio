<mxfile host="app.diagrams.net" modified="2026-07-30T00:00:00.000Z" agent="draw.io" version="24.0.0">
  <diagram name="系统功能模块图 (v3.3)" id="modules">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="title" value="AI网络安全管家 v3.3 — 系统功能模块图" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=18;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="250" y="10" width="600" height="35" as="geometry" />
        </mxCell>

        <!-- Root -->
        <mxCell id="root_node" value="AI 网络安全管家" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a237e;strokeColor=#0d1b5e;fontColor=#fff;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="55" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- Lines from root to row 1 -->
        <mxCell id="r1" style="endArrow=classic;html=1;strokeColor=#333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="80" as="sourcePoint" /><mxPoint x="130" y="140" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="r2" style="endArrow=classic;html=1;strokeColor=#333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="105" as="sourcePoint" /><mxPoint x="350" y="140" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="r3" style="endArrow=classic;html=1;strokeColor=#333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="105" as="sourcePoint" /><mxPoint x="500" y="140" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="r4" style="endArrow=classic;html=1;strokeColor=#333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="105" as="sourcePoint" /><mxPoint x="650" y="140" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="r5" style="endArrow=classic;html=1;strokeColor=#333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="80" as="sourcePoint" /><mxPoint x="870" y="140" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Row 1: Modules 1-4 -->
        <mxCell id="m1_title" value="安全监控模块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565c0;strokeColor=#0d47a1;fontColor=#fff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="140" width="160" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m1_items" value="* 网络连接扫描 (NetworkMonitor)\n* 进程行为检测 (ProcessMonitor)\n* 防火墙检查 (FirewallChecker)\n* 安全日志审计 (SecurityMonitor)\n* 系统资源监控 (CPU/内存)\n* 安全等级综合评估" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="180" width="160" height="115" as="geometry" />
        </mxCell>

        <mxCell id="m2_title" value="AI Agent 智能模块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e65100;strokeColor=#bf360c;fontColor=#fff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="140" width="160" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m2_items" value="* ReAct 核心循环 (AgentCore)\n* 多模型 LLM 路由 (LLMRouter)\n* 30+ 工具注册表 (ToolRegistry)\n* MCP Client/Server\n* 安全沙箱 (6层隔离)\n* 威胁情报 (OTX+NVD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="270" y="180" width="160" height="115" as="geometry" />
        </mxCell>

        <mxCell id="m3_title" value="用户界面模块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#fff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="140" width="160" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m3_items" value="* PyQt5 桌面 GUI (暗色主题)\n* AI 对话窗口 (流式输出)\n* CLI 命令行 (agent_cli.py)\n* 系统托盘 (pystray)\n* REST API 接口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="490" y="180" width="160" height="100" as="geometry" />
        </mxCell>

        <mxCell id="m4_title" value="设备通信模块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6a1b9a;strokeColor=#4a148c;fontColor=#fff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="140" width="160" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m4_items" value="* Serial 模式 (默认, 网络隔离)\n* 自动 COM 口检测\n* 心跳保活 (2秒)\n* 断连自动恢复 (&lt;=10次)\n* JSON over Serial 协议\n* 防重入锁保护" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="710" y="180" width="160" height="115" as="geometry" />
        </mxCell>

        <!-- Row 2: Modules 5-8 -->
        <mxCell id="m5_title" value="角色陪伴系统" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c62828;strokeColor=#b71c1c;fontColor=#fff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="340" width="160" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m5_items" value="* 8 种表情映射\n* 12类 60+ 句台词库\n* LLM 动态台词生成\n* 去重 + 冷却机制\n* 自定义角色导入 (JSON)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="380" width="160" height="100" as="geometry" />
        </mxCell>

        <mxCell id="m6_title" value="知识库 &amp; Skills" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00838f;strokeColor=#006064;fontColor=#fff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="340" width="160" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m6_items" value="* ChromaDB 向量存储\n* MiniLM / TF-IDF 双模\n* 语义检索 (RAG)\n* Skills .md 热加载\n* 对话自动保存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f7fa;strokeColor=#00838f;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="270" y="380" width="160" height="100" as="geometry" />
        </mxCell>

        <mxCell id="m7_title" value="ESP32 固件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontColor=#fff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="340" width="160" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m7_items" value="* OLED 双屏 (表情+仪表盘)\n* 30fps 角色动画\n* 蜂鸣器/LED 告警\n* 按键屏幕切换\n* T-Display 彩屏支持\n* v3.2: 固件指纹握手" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#37474f;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="490" y="380" width="160" height="110" as="geometry" />
        </mxCell>

        <mxCell id="m8_title" value="扩展能力" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f57c00;strokeColor=#e65100;fontColor=#fff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="340" width="160" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m8_items" value="* MCP 协议 (Client+Server)\n* AlienVault OTX 威胁情报\n* NIST NVD CVE 查询\n* DuckDuckGo Web 搜索\n* 用户自定义 Skills\n* v3.3: Claude Code Hook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f57c00;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="710" y="380" width="160" height="110" as="geometry" />
        </mxCell>

        <!-- Row 3: Module 9 (v3.3) -->
        <mxCell id="m9_title" value="纵深防御模块 [v3.3 新增]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ef5350;strokeColor=#b71c1c;fontColor=#fff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="530" width="460" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m9_items" value="* 下载前置扫描 (download_scanner)  — 安装前检测注入/混淆/typosquatting\n* 启动自审计 (self_audit)  — 7层完整性验证, 每次启动~1s快速检查\n* ESP32网络隔离 (esp32_isolation)  — 串口白名单+速率限制+外泄防护+熔断\n* Windows防火墙规则  — C2端口内核级封锁 (4444/31337/6666等)\n* Claude Code Hook  — PreToolUse拦截 Write/Bash 自动扫描\n* 完整性清单 (SHA256基线)  — generate_integrity_manifest.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#ef5350;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="270" y="570" width="460" height="105" as="geometry" />
        </mxCell>

        <!-- Connections to row 3 -->
        <mxCell id="rel_m2_m9" value="v3.3" style="endArrow=classic;html=1;strokeColor=#ef5350;strokeWidth=2;fontSize=9;fontColor=#ef5350;fontStyle=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="350" y="480" as="sourcePoint" /><mxPoint x="350" y="530" as="targetPoint" /></mxGeometry>
