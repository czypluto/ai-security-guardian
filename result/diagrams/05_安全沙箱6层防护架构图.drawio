          <mxGeometry x="290" y="453" width="350" height="28" as="geometry" />
        </mxCell>
        <mxCell id="l2_desc" value="ctypes 调用 kernel32.dll → CreateJobObjectW → SetInformationJobObject&#10;KILL_ON_JOB_CLOSE | ActiveProcessLimit=1 | 桌面隔离 (UI Restrictions)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="220" y="485" width="540" height="35" as="geometry" />
