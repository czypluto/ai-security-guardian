          <mxGeometry x="120" y="168" width="70" height="28" as="geometry" />
        </mxCell>
        <mxCell id="l5_title" value="文件系统守卫 (Filesystem Guard)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontStyle=1;fontColor=#e65100;align=left;" vertex="1" parent="1">
          <mxGeometry x="200" y="168" width="300" height="28" as="geometry" />
        </mxCell>
        <mxCell id="l5_desc" value="禁止写入非授权目录 (仅允许 %TEMP% 等白名单路径)&#10;所有文件系统操作受到监控和拦截" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="130" y="200" width="660" height="35" as="geometry" />
        </mxCell>

